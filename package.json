{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:gateway": "node --test tests/elevenlabs-gateway.test.js",
    "test:chat-ui": "node --experimental-strip-types --test tests/chat-rich-content.test.ts",
    "test:routing-eval": "node --experimental-strip-types --test tests/routing-eval.test.ts",
    "routing:eval": "node --experimental-strip-types scripts/routing-eval/cli.ts",
    "routing:eval:live": "node --experimental-strip-types scripts/routing-eval/cli.ts --live",
    "routing:eval:router": "node --experimental-strip-types scripts/routing-eval/router-check.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:routing-eval": "tsc -p tsconfig.routing-eval.json"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.17.0",
    "@supabase/supabase-js": "^2.112.2",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.344.0",
    "opus-recorder": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.21.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.1"
  }
}
